# Build output
build/
*.iml

# Android signing — never commit these
android/key.properties
*.jks
*.keystore

# Per-project Firebase config files carry project identifiers and stay out of
# the repo, per the PRD.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
.firebase/

# Cloud Functions
functions/node_modules/
functions/.env
functions/lib/

node_modules/

# Secrets
.env
.env.local
.vercel/

# Emulator debug logs
firestore-debug.log
firebase-debug.log
ui-debug.log

# Also ignore dependency-cache symlinks
node_modules

# Only the React Native product is needed for EAS builds.
/apps/web
/apps/mobile/qa
/apps/mobile/.node_modules-offloaded
/apps/mobile/dist
/apps/mobile/.expo
/apps/mobile/ios
/apps/mobile/android
/functions
/docs
/android
/ios
/build

# Local configuration and credentials
.env.*
!.env.example
!.env.label.example
*.service-account.json

# Keep machine settings, generated reports and signing material out of uploads.
/outputs
/apps/mobile/.claude
/apps/mobile/.codex
*.p8
*.p12
*.pem
*.mobileprovision
/apps/mobile/google-services.json
/apps/mobile/GoogleService-Info.plist
