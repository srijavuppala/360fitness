rules_version = '2';

// Every document a user owns lives under users/{uid}, so ownership is the only
// check needed. Nothing here is readable by another signed-in user.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Covers profile, targets, planMeals, chatLog, days and settings.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // BEGIN MOBILE PROFILE SCHEMA
    // Generated by scripts/profile-rules.ts. Legacy /users rules do not cover this collection.
    function validMobileAnswers(a) {
      return a is map && a.keys().hasOnly(["age","sex","heightCm","currentWeightKg","primaryGoal","targetWeightKg","weeklyPace","outcome","activity","diet","dietOther","allergies","allergyOther"])
        && a.age in ["Under 18","18–24","25–34","35–44","45–54","55–64","65+","Prefer not to say"]
        && a.sex in ["Female","Male","Prefer not to say"]
        && (a.heightCm is string && a.heightCm.size() <= 300 && a.heightCm.matches('^[0-9]+(\\.[0-9]{1,2})?$') && float(a.heightCm) >= 100 && float(a.heightCm) <= 250)
        && (a.currentWeightKg is string && a.currentWeightKg.size() <= 300 && a.currentWeightKg.matches('^[0-9]+(\\.[0-9]{1,2})?$') && float(a.currentWeightKg) >= 25 && float(a.currentWeightKg) <= 350)
        && a.primaryGoal in ["Build consistent habits","Understand my nutrition","Support my fitness"]
        && (a.targetWeightKg is string && a.targetWeightKg.size() <= 300 && a.targetWeightKg.matches('^[0-9]+(\\.[0-9]{1,2})?$') && float(a.targetWeightKg) >= 25 && float(a.targetWeightKg) <= 350)
        && ((math.abs(float(a.targetWeightKg) - float(a.currentWeightKg)) > 0.5) ? a.weeklyPace in ["Gentle · 0.25 kg a week","Steady · 0.5 kg a week","Faster · 0.75 kg a week"] : !('weeklyPace' in a))
        && (a.outcome is string && a.outcome.size() > 0 && a.outcome.size() <= 300)
        && a.activity in ["Mostly sitting","Lightly active","Moderately active","Very active","Varies day to day"]
        && a.diet in ["No specific diet","Vegetarian","Vegan","Pescatarian","Flexitarian","Halal","Kosher","Other"]
        && ((a.diet == "Other") ? (a.dietOther is string && a.dietOther.size() > 0 && a.dietOther.size() <= 300) : !("dietOther" in a))
        && (a.allergies is list && a.allergies.size() > 0 && a.allergies.size() == a.allergies.toSet().size() && a.allergies.hasOnly(["None known","Milk","Eggs","Peanuts","Tree nuts","Wheat","Soy","Fish","Shellfish","Sesame","Other","Not sure"]) && (a.allergies.size() == 1 || !a.allergies.hasAny(['None known', 'Not sure', 'No preference yet', 'None'])))
        && (("Other" in a.allergies) ? (a.allergyOther is string && a.allergyOther.size() > 0 && a.allergyOther.size() <= 300) : !("allergyOther" in a));
    }
    function validMobileProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'revision', 'generation', 'profile', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'revision', 'generation', 'profile', 'updatedAt'])
        && d.schemaVersion == 1 && d.revision is int && d.revision > 0
        && d.generation is string && d.generation.matches('^[A-Za-z0-9]{20}$')
        && d.updatedAt == request.time
        && d.profile is map && d.profile.keys().hasOnly(['version', 'answers', 'updatedAt'])
        && d.profile.version == 2 && d.profile.updatedAt is string && d.profile.updatedAt.size() <= 40
        && validMobileAnswers(d.profile.answers);
    }
    match /mobileProfiles/{uid} {
      allow read, delete: if isOwner(uid) && request.auth.token.email_verified == true;
      allow create: if isOwner(uid) && request.auth.token.email_verified == true
        && validMobileProfile() && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && request.auth.token.email_verified == true
        && validMobileProfile() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.generation == resource.data.generation;
    }
    // END MOBILE PROFILE SCHEMA

    // Private versioned meal-prep backup. JSON is bounded here and fully validated
    // by clients before use; it is never treated as server-authoritative nutrition.
    function validMealPrepBackup() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'revision', 'generation', 'payload', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'revision', 'generation', 'payload', 'updatedAt'])
        && d.schemaVersion == 1 && d.revision is int && d.revision > 0
        && d.generation is string && d.generation.matches('^[A-Za-z0-9]{20}$')
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 180000
        && d.updatedAt == request.time;
    }
    match /mobileMealPrep/{uid} {
      allow read, delete: if isOwner(uid) && request.auth.token.email_verified == true;
      allow create: if isOwner(uid) && request.auth.token.email_verified == true
        && validMealPrepBackup() && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && request.auth.token.email_verified == true
        && validMealPrepBackup() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.generation == resource.data.generation;
    }

    // Anything not matched above is denied, including any future collection
    // added outside a user document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
