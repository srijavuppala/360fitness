# Enable only after native Firebase setup, App Check and the callable deployment.
EXPO_PUBLIC_LABEL_AI_ENABLED=false
# Meal photos through Firebase AI Logic (works on the Spark plan and in Expo Go).
# Requires Firebase Console > AI Logic > Get started (Gemini Developer API).
EXPO_PUBLIC_MEAL_PHOTO_AI_LOGIC=false
# Build-time paths; native Firebase config, not service-account private keys.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
# The Gemini key belongs ONLY in the functions server environment / Secret Manager.

# Firebase Console > Project settings > Your apps > Web app SDK configuration.
# These are public client identifiers; never put service-account or Gemini keys here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
